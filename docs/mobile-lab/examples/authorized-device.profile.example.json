{
  "id": "authorized-device-mobile-e2e",
  "name": "Authorized debug build on a dedicated device \u2014 trust evidence required",
  "is_enabled": true,
  "runtime_type": "manual",
  "android_api_level": 34,
  "device_name": "Dedicated authorized AVD",
  "adb_serial": "REPLACE_WITH_ADB_SERIAL",
  "appium_server_url": "http://127.0.0.1:4723",
  "proxy_type": "mitmproxy",
  "proxy_host": "127.0.0.1",
  "proxy_port": 18080,
  "certificate_mode": "manual_verified",
  "config_json": {
    "strict_real_e2e": true,
    "offline_simulator": false,
    "adb_path": "adb",
    "aapt_path": "aapt",
    "apksigner_path": "apksigner",
    "mitmdump_path": "mitmdump",
    "managed_proxy": true,
    "mitm_proxy_mode": "regular",
    "proxy_listen_host": "127.0.0.1",
    "proxy_use_adb_reverse": true,
    "capture_allowed_hosts": [
      "api.your-authorized-app.example"
    ],
    "certificate_provisioning": "managed_mitmproxy",
    "allow_system_ca_install": false,
    "emulator_start_command": "",
    "minimum_decrypted_flows": 1,
    "minimum_workflow_drafts": 1,
    "device_wait_timeout_ms": 90000,
    "launch_timeout_ms": 15000,
    "action_delay_ms": 300,
    "manual_certificate_verified": false,
    "manual_certificate_evidence": ""
  }
}
